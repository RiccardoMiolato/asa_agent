{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "sourceMap": true,
        "types": [
            "node",
        ]
    },
    "include": [
        "index.ts",
        "declaration.d.ts",
        "src/**/*.ts",
        "types/**/*.d.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "fast-downward"
    ]
}
