{
  "name": "asa_agent",
  "version": "1.0.0",
  "description": "Asa agent for uni course project",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "start": "rm -rf -- logs/branch-and-bound/* &&node --env-file=.env dist/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test dist/src/_action-ack.spec.js dist/src/_option-pruning.spec.js dist/src/_search-intention.spec.js",
    "test:missions": "npm run build && node --test dist/src/_level-two-mission.test.js",
    "test:actions": "npm run build && node --test dist/src/_action-ack.spec.js",
    "test:pruning": "npm run build && node --test dist/src/_option-pruning.spec.js",
    "ghost-map": "npm run build && npm run start"
  },
  "dependencies": {
    "@unitn-asa/deliveroo-js-sdk": "^1.3.10",
    "dotenv": "^17.4.2",
    "duck-duck-scrape": "^2.2.7",
    "heap-js": "^2.7.1",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}